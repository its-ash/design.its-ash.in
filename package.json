{
  "name": "design-prompt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "deploy": "nuxt generate && cp docs/CNAME .cname-backup 2>/dev/null; rimraf docs && cp -r .output/public docs && cp .cname-backup docs/CNAME 2>/dev/null; rm -f .cname-backup",
    "postinstall": "nuxt prepare"
  },
  "devDependencies": {
    "@nuxtjs/sitemap": "^6.1.0",
    "@nuxtjs/robots": "^5.2.0",
    "@nuxtjs/tailwindcss": "^6.12.0",
    "nuxt": "^3.12.0",
    "vue": "^3.4.0",
    "vue-router": "^4.4.0"
  },
  "dependencies": {
    "marked": "^13.0.0",
    "rimraf": "^5.0.0"
  }
}